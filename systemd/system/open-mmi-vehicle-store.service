[Unit]
Description=Open MMI Purpose-Scoped Vehicle-Data Store
Documentation=https://github.com/open-mmi/open-mmi
After=local-fs.target

[Service]
Type=simple
User=root
Group=open-mmi
ExecStart=/opt/open-mmi/venv/bin/python -I -m ui.vehicle_store serve
Restart=on-failure
RestartSec=2
RuntimeDirectory=open-mmi-vehicle-store
RuntimeDirectoryMode=0750
StateDirectory=open-mmi/vehicle-data
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

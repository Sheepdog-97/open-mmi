[Unit]
Description=Open MMI CAN-Silence Power Policy
Documentation=https://github.com/open-mmi/open-mmi
After=local-fs.target open-mmi-vehicle-config-coordinator.service
Wants=open-mmi-vehicle-config-coordinator.service

[Service]
Type=simple
EnvironmentFile=/etc/open-mmi/vehicle-config-coordinator.env
Environment=OPEN_MMI_POWER_POLICY=/etc/open-mmi/power-policy.json
# Bootstrap volatile transaction locks from the packaged tmpfiles rule.
# This also covers a first update executed by the previous manage.sh,
# which can deploy new payloads and units but not new shell functions.
ExecStartPre=/usr/bin/systemd-tmpfiles --create /opt/open-mmi/packaging/tmpfiles/open-mmi.conf
ExecStart=/opt/open-mmi/venv/bin/open-mmi-powerd run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=false
InaccessiblePaths=/home /root
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_CAN AF_NETLINK AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
